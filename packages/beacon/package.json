{
  "name": "@tempex/beacon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tempex Beacon: the machine-readable front door that lets agents discover, verify, and onboard to Tempex arbitration with no balance and no human",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "tsx src/cli.ts serve",
    "manifest": "tsx src/cli.ts manifest",
    "stats": "tsx src/cli.ts stats",
    "reputation": "tsx src/cli.ts reputation",
    "onboard": "tsx src/cli.ts onboard",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@tempex/sdk": "workspace:*",
    "viem": "^2.38.5"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
