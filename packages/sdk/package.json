{
  "name": "@tempex/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "TypeScript SDK for Tempex: escrow jobs, TIP-20 memo settlement, EIP-712 verdicts on Tempo",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "deploy:escrow": "tsx scripts/deploy.ts"
  },
  "dependencies": {
    "viem": "^2.38.5"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
