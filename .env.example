# ---------------------------------------------------------------------------
# Tempex environment. Copy to `.env` (gitignored, chmod 600) and fill in keys.
#
# Every address below is public chain state; every *_KEY is a secret and belongs
# only in `.env`. Use throwaway testnet wallets — Moderato has no real value, but
# the discipline is the point.
# ---------------------------------------------------------------------------

# Tempo network
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# --- Accounts (testnet only; generate each with `cast wallet new`) -----------
# Addresses are derived from the keys and are read back by the SDK, the demo
# runner, and the deploy script.
DEPLOYER_KEY=
DEPLOYER_ADDRESS=
BUYER_KEY=
BUYER_ADDRESS=
SELLER_KEY=
SELLER_ADDRESS=
ARBITER_KEY=
ARBITER_ADDRESS=

# --- Live Moderato deployment ------------------------------------------------
# The public escrow (block 38,497,375; record in deployments/moderato.json). Leave
# it as-is to run against the public deployment; change it to use your own.
TEMPEX_ESCROW=0x001c8C3391E591C9CBDFdFE4227e585b86041157
# alphaUSD, one of the TIP-20 stablecoins predeployed on Moderato (6 decimals).
TEMPEX_TOKEN=0x20c0000000000000000000000000000000000001
# Only read when deploying (pnpm deploy:escrow): who governs the new escrow, the
# house arbiter whose signature settles jobs made with createJob (each job locks
# the arbiter it was created with), and where the protocol's fees accumulate.
TEMPEX_OWNER=
TEMPEX_ARBITER=
TEMPEX_TREASURY=

# Constructor fee parameters, in basis points. The contract caps them at 500
# (5%) and 1000 (10%) respectively, so an out-of-range value simply reverts.
TEMPEX_PLATFORM_FEE_BPS=50
TEMPEX_ARBITRATION_FEE_BPS=200


# --- Artifact directories ---------------------------------------------------
# Where the arbiter writes signed evidence and where run receipts land. Both
# default to `evidence/` and `runs/` at the repo root.
TEMPEX_EVIDENCE_DIR=
TEMPEX_RUNS_DIR=

# --- Beacon (the discovery/onboarding front door) ----------------------------
# All optional; the defaults below are what `pnpm beacon` uses when unset.

# What the manifest calls itself, and the version agents see in it.
BEACON_NAME=Tempex Beacon
BEACON_VERSION=0.1.0

# Listen address, and the public origin agents should call back on. They differ
# whenever the beacon sits behind a tunnel or proxy — set BEACON_HOST to the
# outside URL so the manifest does not advertise an unreachable address.
BEACON_LISTEN=127.0.0.1
BEACON_PORT=8787
BEACON_HOST=http://127.0.0.1:8787

# Network label in the manifest. Cosmetic, but agents match on it.
BEACON_NETWORK=tempo:moderato

# Tempo's hosted fee payer. This is what makes zero-balance onboarding real:
# the agent signs the payment, this service signs the fee. Empty disables it.
BEACON_SPONSOR_URL=https://sponsor.moderato.tempo.xyz

# Where discovery fees go, and what a paid query costs in whole alphaUSD units.
# Empty BEACON_TREASURY means discovery is served free. Falls back to
# TEMPEX_TREASURY when unset.
BEACON_TREASURY=
BEACON_DISCOVERY_PRICE=0.01

# Blocks per `eth_getLogs`. Moderato rejects any range wider than 100,000 with
# "query exceeds max block range", so values above that are clamped down.
BEACON_SCAN_CHUNK_BLOCKS=50000
# Where the indexer starts. Defaults to the escrow's deployment block — nothing
# before it can mention Tempex.
TEMPEX_INDEX_FROM_BLOCK=38497375

# Runtime state: the signed agent registry and the challenge store. Gitignored.
BEACON_DATA_DIR=
BEACON_REGISTRY_FILE=registry.json
# Seconds a registration challenge stays valid. Short enough that a captured
# challenge cannot be replayed after the agent notices.
BEACON_CHALLENGE_TTL=300

# --- Optional: LLM arbiter ---------------------------------------------------
# Without a key the deterministic rule engine rules alone and says so in the
# verdict notes. With one, the LLM proposes an award that `clampToBand` bounds to
# the rule-derived band — the judge never has unilateral power either way.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=20000

# Note: agent identity is enforced by the escrow itself, not by an agent registry.
# Tempo has no canonical ERC-8004 deployment, so Tempex opts out of that standard:
# the escrow records the arbiter it trusts per job, and every ruling must recover
# to that address under EIP-712 or `resolve` reverts.
